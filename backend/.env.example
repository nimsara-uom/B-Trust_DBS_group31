# ============================================================
# Microbanking Management System — Environment Variables
# ============================================================
# Copy this file to  .env  and fill in your values.
# NEVER commit the real .env file to Git.
# ============================================================

# MySQL Database (alwaysdata)
DB_HOST=mysql-btrust.alwaysdata.net
DB_PORT=3306
DB_USER=btrust_admin
DB_PASSWORD=<password>
DB_NAME=btrust_group31
DB_USE_SSL=false

# JWT / Auth
AUTH_USERNAME=admin
AUTH_PASSWORD=admin

# Brevo (Sendinblue) Transactional Email & SMTP Relay
BREVO_API_KEY=<your-brevo-api-key>
BREVO_SENDER_EMAIL=noreply@btrustbank.lk
BREVO_SENDER_NAME=B-Trust Digital Banking
SMTP_SERVER=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_LOGIN=<your-smtp-login>
SMTP_PASSWORD=<your-smtp-key>